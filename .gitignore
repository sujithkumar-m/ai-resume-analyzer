# ============================================
# AI Resume Analyzer - Git Ignore Rules
# ============================================

# Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.env

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
dist/
frontend/dist/
dist-ssr/
*.local

# Editor & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db

# Temporary / Scratch files
*.tmp
*.bak
